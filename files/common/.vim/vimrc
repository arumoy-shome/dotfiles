" This is the fallback editor. nvim is the daily driver and `vim` is aliased
" to it, so this config is only reached as `vi` or `\vim` — usually on a box
" where nothing has been installed. It therefore has no plugins and no plugin
" manager: everything below ships with vim itself.

" defaults {{{1
" Sourced first so every setting below wins. See :h defaults.vim
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim
" }}}
" packages {{{1
" Bundled with vim 9.1; these replace what used to be plugins.
packadd comment       " gc / gcc / gC, plus the ic / ac text objects
packadd editorconfig  " honours ~/.editorconfig
packadd matchit       " % across if/endif, tags, quotes
packadd netrw         " no longer loaded by default in 9.1
packadd cfilter       " :Cfilter / :Lfilter to narrow the quickfix list
packadd hlyank        " brief highlight on yank, as in nvim
packadd nohlsearch    " drops search highlight once idle or on insert
" }}}
" settings {{{1
set laststatus=2

set number
set relativenumber

set ignorecase
set smartcase
set infercase

set splitright
set splitbelow

set noswapfile

set clipboard+=unnamedplus

set breakindent
set linebreak
set nojoinspaces
set autoindent

set autowrite
set autoread

" nohlsearch clears the highlight on CursorHold; the 4s default is too slow
" to feel like anything happened.
set updatetime=500

" XXX see :h fo-table for more details
" Continue comment leaders and format lists, but never auto-wrap.
set formatoptions=roq/nl1j

" XXX see :help shortmess for more info
set shortmess=aoOstTWI

set wildmenu
set wildoptions=pum
set wildmode=longest:full,full
set wildignore+=*/.git/*,*/node_modules/*,*/__pycache__/*,*.pyc

" :find searches the whole tree, standing in for a fuzzy finder. Drop the **
" if this ever feels slow in a large repo.
set path=.,,**

set list
set listchars=nbsp:⦸,extends:»,precedes:«,tab:▷⋯,trail:•

set fillchars=diff:∙,fold:∙,eob:\ ,vert:┃

set spelllang=en,nl

" start unfolded
set foldlevelstart=99

" Baseline indentation. The editorconfig package overrides these per buffer
" wherever an .editorconfig applies.
set expandtab
set tabstop=2
set shiftwidth=2
set smarttab
" }}}
" netrw {{{1
let g:netrw_banner = 0
" }}}
" keybindings {{{1
let mapleader = "\<Space>"
nnoremap <leader>so :source $MYVIMRC<cr>
nnoremap <leader>q :quit<cr>

" Move by display line, but only when no count is given, so 5j still lands
" five real lines down.
nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <expr> k v:count ? 'k' : 'gk'
xnoremap <expr> j v:count ? 'j' : 'gj'
xnoremap <expr> k v:count ? 'k' : 'gk'

" Open netrw on the containing directory.
nnoremap - :Explore<cr>

" These end in a space rather than <cr>: they open a prompt and lean on
" wildmenu to complete, which is the native stand-in for a fuzzy finder.
nnoremap <leader>sf :find<space>
nnoremap <leader><leader> :buffer<space>
nnoremap <leader>sh :help<space>
nnoremap <leader>/ :g//#<left><left>

cabbrev grpe grep
" }}}
" autocommands {{{1
augroup AruWindow
  autocmd!
  autocmd VimResized * wincmd =
augroup END

augroup AruFiletypePlugins
  autocmd!
  autocmd FileType gitcommit setlocal spell
  autocmd FileType man,help let b:EditorConfig_disable = 1
  autocmd FileType qf,help,git nnoremap <buffer> q :close<cr>
  autocmd FileType qf setlocal nonumber norelativenumber
augroup END
" }}}
" statusline {{{1
" One quoted assignment rather than a stack of `set statusline+=\ ` lines: the
" padding spaces are significant, and trailing whitespace does not survive
" every editor.
let &statusline = ' %<%{aru#statusline_fileprefix()}%t'
      \ .. ' %([%{aru#statusline_ft()}%{aru#statusline_fenc()}%R%M]%)'
      \ .. '%= %l:%L:%P '
" }}}
" highlights {{{1
if has('termguicolors')
  set termguicolors
endif

" High-churn colours live in an untracked sibling; absent is fine.
silent! source ~/.vim/colors.vim
" }}}

